<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="hack.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="RebornUI\RebornDragControl.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="RebornUI\RebornLabel.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="RebornUI\RJComboBox.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="RebornUI\TrackBarFloat.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="hack.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
</Project>